# Chatwoot substrate. Verify this tag exists before the first QA build.
CHATWOOT_TAG=v4.16.1
CHATWOOT_BIND_ADDRESS=127.0.0.1
# Frankie already uses 3000 for Command Center.
CHATWOOT_HOST_PORT=3001

# Chatwoot application secrets.
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
FRONTEND_URL=http://localhost:3001
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Chatwoot Postgres.
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=chatwoot

# Chatwoot Redis.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_me

# Chatwoot system email only. Customer inboxes are configured in the UI.
MAILER_SENDER_EMAIL=Dewie Desk <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login

# Bridge transport. The draft path only posts private notes. The webhook secret
# must match the Chatwoot subscription.
CHATWOOT_BASE_URL=http://127.0.0.1:3001
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
# Internal bearer token for POST /internal/chatwoot/outbound-message, which sends
# a customer-visible reply on an existing conversation. Empty = disabled (503).
# Use 32+ random characters, distinct from both secrets above. Dry-run and shadow
# mode do not apply to it. See docs/chatwoot-outbound-transport.md.
BRIDGE_OUTBOUND_TOKEN=
# Which Chatwoot EMAIL inbox each store sends from. A refund for an ABS order must
# go out from the ABS inbox: the reply-to is the address the customer answers, and
# it has to be the one that store's mail is worked from.
#   BRIDGE_OUTBOUND_INBOX_IDS=abs:1,actex:3
# Required by /resolve-conversation and by the outbound recipient check; without
# either this or the single-inbox variable below, both endpoints 503. Parsed
# strictly — one malformed pair refuses every store rather than routing half.
BRIDGE_OUTBOUND_INBOX_IDS=
# Single-inbox fallback, used for every store when the map above is empty. Fine
# for a one-store deployment or a test; not for production here, which has two.
BRIDGE_OUTBOUND_INBOX_ID=
# The Chatwoot EMAIL inbox refund notices use (its numeric id). Required by both
# /internal/chatwoot/outbound-message and /resolve-conversation; unset = 503.
BRIDGE_OUTBOUND_INBOX_ID=

# Safe defaults. Shadow mode stops before the drafter; dry-run stops before a
# private note is posted. Both must be explicitly disabled for the final path.
BRIDGE_SHADOW_MODE=true
BRIDGE_DRY_RUN=true
# ORDER/PG messages become DewieOps order packets in Cloud SQL (order_packets)
# instead of a reply draft. Needs the 004 migration and CLOUDSQL_* settings.
# Off by default; see DewieOps docs/order-capture.md.
BRIDGE_ORDER_CAPTURE=false
# Attachment downloads are bounded before PDF extraction or vision processing.
BRIDGE_ATTACHMENT_MAX_BYTES=10485760
BRIDGE_STATE_DB=

# Desk model settings are intentionally independent of Discord's LLM_PROVIDER.
DESK_CLASSIFIER_PROVIDER=anthropic
DESK_CLASSIFIER_MODEL=
DESK_CLASSIFIER_CONFIDENCE_FLOOR=0.75
DESK_DRAFTER_PROVIDER=anthropic
DESK_DRAFTER_MODEL=
# Attachment transcription and short/order extraction stay independently
# selectable; changing the drafter must not silently change these calls.
DESK_UTILITY_PROVIDER=anthropic
DESK_UTILITY_MODEL=
