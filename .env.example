# Chatwoot substrate. Verify this tag exists before the first QA build.
CHATWOOT_TAG=v4.16.1
CHATWOOT_BIND_ADDRESS=127.0.0.1
# Frankie already uses 3000 for Command Center.
CHATWOOT_HOST_PORT=3001

# Chatwoot application secrets.
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
FRONTEND_URL=http://localhost:3001
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Chatwoot Postgres.
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=chatwoot

# Chatwoot Redis.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_me

# Chatwoot system email only. Customer inboxes are configured in the UI.
MAILER_SENDER_EMAIL=Dewie Desk <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login

# Bridge transport. The API token may post private notes; there is no send API
# in the bridge. The webhook secret must match the Chatwoot subscription.
CHATWOOT_BASE_URL=http://127.0.0.1:3001
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Safe defaults. Shadow mode stops before the drafter; dry-run stops before a
# private note is posted. Both must be explicitly disabled for the final path.
BRIDGE_SHADOW_MODE=true
BRIDGE_DRY_RUN=true
BRIDGE_STATE_DB=

# Desk model settings are intentionally independent of Discord's LLM_PROVIDER.
DESK_CLASSIFIER_PROVIDER=anthropic
DESK_CLASSIFIER_MODEL=
DESK_CLASSIFIER_CONFIDENCE_FLOOR=0.75
DESK_DRAFTER_PROVIDER=anthropic
DESK_DRAFTER_MODEL=
# Attachment transcription and short/order extraction stay independently
# selectable; changing the drafter must not silently change these calls.
DESK_UTILITY_PROVIDER=anthropic
DESK_UTILITY_MODEL=
