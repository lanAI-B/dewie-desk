# ── Chatwoot image ────────────────────────────────────────────────────────────
# Pin a real stable tag before first boot: https://hub.docker.com/r/chatwoot/chatwoot/tags
CHATWOOT_TAG=latest   # TODO: pin, e.g. v4.x.x

# ── Core secrets ────────────────────────────────────────────────────────────
# Generate: docker compose run --rm rails bundle exec rails secret
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# ── Postgres (matches docker-compose) ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=chatwoot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_me

# ── Email ─────────────────────────────────────────────────────────────────────
# NOTE: the customer-facing mailbox is connected in the Chatwoot UI, NOT here.
#       Now: Rackspace IMAP/SMTP (Inbox -> Add Inbox -> Email, plain auth).
#       Later: M365 via the Microsoft OAuth channel, once migration lands. See README.
# These SMTP vars are only for Chatwoot's own system mail (password resets, etc.).
MAILER_SENDER_EMAIL=Dewie Desk <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login

# ── dewie-desk-bridge (Phase 2) ───────────────────────────────────────────────
# The bridge references the DewieBrain repo — it does NOT copy the drafter.
DEWIE_BRAIN_PATH=C:\Users\lana\Documents\DewieBrain
CHATWOOT_API_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=      # Chatwoot: Profile -> Access Token
BRIDGE_DRY_RUN=true      # true = log the draft, don't even post the private note yet
