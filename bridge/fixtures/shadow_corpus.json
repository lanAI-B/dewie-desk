{
  "corpus": "desk-shadow-v1",
  "note": [
    "Sanitized, wholly synthetic desk traffic for the Slice 3 offline shadow replay.",
    "No captured production payload, customer name, real address, order number or token",
    "appears here. Every address is on example.com / example.net / a .example TLD, which",
    "cannot resolve, so a mistake in this corpus cannot mail anyone.",
    "",
    "'classification' is the label the corpus asserts the classifier would return. It is",
    "recorded, not computed: the replay spends no model call, so this file validates the",
    "POLICY, not the classifier's accuracy. null means the classifier failed or returned",
    "something unvalidatable. The key being ABSENT asserts the classifier is never reached",
    "for that case, and the replay reports a corpus defect if it is.",
    "",
    "'expected' is the outcome a human says is correct for the message, so a disagreement",
    "with the policy shows up as a finding rather than being assumed away."
  ],
  "base": {
    "event": "message_created",
    "id": 1000,
    "message_type": "incoming",
    "private": false,
    "content": "",
    "content_attributes": {"email": {"subject": ""}},
    "sender": {"email": "", "name": "", "type": "contact"},
    "conversation": {"id": 500, "channel": "Channel::Email", "messages": [{"sender_type": "Contact"}]},
    "inbox": {"id": 2, "name": "Support"},
    "account": {"id": 1}
  },
  "cases": [
    {
      "id": "transport-outgoing-agent-reply",
      "note": "An agent's own outbound reply echoed back by Chatwoot.",
      "expected": "transport_filtered",
      "payload": {
        "id": 1001,
        "message_type": "outgoing",
        "content": "Thanks, that is on its way.",
        "sender": {"email": "cs@example.com", "type": "user"}
      }
    },
    {
      "id": "transport-private-note",
      "note": "A private note between agents, including one Dewie posted itself.",
      "expected": "transport_filtered",
      "payload": {
